{
  "manifest_version": 3,
  "name": "Bell Clock",
  "version": "4.3",
  "description": "See the current class period and time remaining for your school's bell schedule.",
  "permissions": [
    "sidePanel",
    "alarms",
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/quinnmackenzie1/bell-schedules/*",
    "https://quinnmackenzie1.github.io/bell-schedules/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bell Clock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}